# ---- other creators' words and voices (study material stays on this machine; re-made by /voice-learn and the
# research tools). The original host's (thebentist) transcripts and passage bank ship with his permission.
# To keep YOUR own transcripts in your repo too, add: !voice/<your id>/transcripts/ and !voice/<your id>/passages.json
voice/*/transcripts/
!voice/thebentist/transcripts/
voice/*/audio/
voice/*/passages.json
!voice/thebentist/passages.json
reference/transcripts/
styles/*/ref-transcript*
videos/*/source/

# ---- Ben's voice exports (ElevenLabs)
exports/

# ---- render output and per-video working folders (regenerated by the pipeline)
renders/*
!renders/resolve-smoke/
renders/resolve-smoke/*
!renders/resolve-smoke/RESULT.md
styles/*/src/
videos/*/raw/
videos/*/out/
videos/*/work/
videos/*/take/
videos/*/sources/
videos/*/assets/
videos/*/broll/
videos/*/music/
videos/*/sfx/
videos/*/scenes/out/
videos/*/scenes/**/frames/
videos/*/review/uploads/
